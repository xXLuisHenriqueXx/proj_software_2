datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows"]
}

model User {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  email           String   @unique
  password        String
  name            String
  role            Role     @default(USER)
  parentalControl Boolean  @default(false)
  active          Boolean  @default(true)
  cnpj            String?  @unique
  pix_key         String?  @unique
  picture         String?  @db.Text

  addressDistrict String
  addressStreet   String
  addressNumber   Int
  addressDetail   String?
  addressCep      String

  // Relacionamentos
  toys Toy[] @relation("UserToys")

  history HistoryEntry[] @relation("UserHistory")

  ratings          Rate[]            @relation("UserRates")
  organizationInfo organizationInfo?

  chats    Chat[]    @relation("ChatParticipants")
  messages Message[] @relation("UserMessages")

  Favorite Favorite[] @relation("UserFavorites")
}

model organizationInfo {
  id             String   @id @default(uuid())
  organizationId String   @unique
  organization   User     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String
  phone_number1  String
  phone_number2  String?
  ageRange       AgeRange
  approved       Boolean  @default(false)
  website_url    String
  lat            Float
  long           Float
}

enum Role {
  USER
  ADMIN
}

model Toy {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  name        String
  description String

  ownerId String
  owner   User   @relation("UserToys", fields: [ownerId], references: [id], onDelete: Cascade)

  history HistoryEntry[] @relation("ToyHistory")
  price   Float

  isNew       Boolean
  canTrade    Boolean
  canLend     Boolean
  usageTime   Int
  type        ToyType[]
  ToyPictures ToyPicture[] @relation("Pictures")
  ageGroup    AgeRange
  discount    Int
  Favorite    Favorite[]   @relation("ToyFavorites")
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  toyId String
  toy   Toy    @relation("ToyFavorites", fields: [toyId], references: [id], onDelete: Cascade)

  @@unique([userId, toyId])
}

enum ToyType {
  BOYS
  GIRLS
  ARTISTIC
  ADVENTURE
  DOLLS
  CARS
  CARDS
  EDUCATIONAL
  SPORTS
  STRATEGY
  WORDS
  BABIES
  PUZZLES
  SIMULATION
  BOARD
  VIDEOGAME
}

enum AgeRange {
  ZERO_TO_ONE
  ONE_TO_THREE
  THREE_TO_SIX
  SIX_TO_TWELVE
  TWELVE_OR_MORE
}

model ToyPicture {
  id      String @id @default(uuid())
  order   Int
  toyId   String
  toy     Toy    @relation("Pictures", fields: [toyId], references: [id], onDelete: Cascade)
  picture String
}

model HistoryEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  visible   Boolean  @default(true)

  userId String?
  user   User?   @relation("UserHistory", fields: [userId], references: [id], onDelete: Cascade)

  toyId String
  toy   Toy    @relation("ToyHistory", fields: [toyId], references: [id], onDelete: Cascade)
}

model Rate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  value     Int
  comment   String?

  userId String
  user   User   @relation("UserRates", fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  participants User[]    @relation("ChatParticipants")
  messages     Message[] @relation("ChatMessages")
}

enum HighlightType {
  FREE
  NEARBY
  POPULAR
  RECENT
  NEW
}

model Highlight {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  name        String
  description String?
  type        HighlightType
  picture     String?       @db.Text
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  content   String
  seen      Boolean @default(false)

  senderId String
  sender   User   @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  chatId String
  chat   Chat   @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
}
